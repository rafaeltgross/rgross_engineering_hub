<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- LIST VIEW -->
    <record id="view_rgross_engineering_project_list" model="ir.ui.view">
        <field name="name">rgross.engineering.project.list</field>
        <field name="model">rgross.engineering.project</field>
        <field name="arch" type="xml">
            <list string="Engineering Projects" decoration-danger="status == 'cancelled'" decoration-success="status == 'done'" decoration-warning="status in ('waiting_customer', 'waiting_supplier')">
                <field name="project_code" optional="show"/>
                <field name="name"/>
                <field name="customer_id"/>
                <field name="project_type"/>
                <field name="status" widget="badge" decoration-success="status == 'done'" decoration-danger="status == 'cancelled'" decoration-warning="status in ('waiting_customer','waiting_supplier')" decoration-info="status == 'active'"/>
                <field name="priority"/>
                <field name="deadline"/>
                <field name="real_hours"/>
                <field name="real_profit" optional="show"/>
                <field name="currency_id" column_invisible="True"/>
            </list>
        </field>
    </record>

    <!-- FORM VIEW -->
    <record id="view_rgross_engineering_project_form" model="ir.ui.view">
        <field name="name">rgross.engineering.project.form</field>
        <field name="model">rgross.engineering.project</field>
        <field name="arch" type="xml">
            <form string="Engineering Project">
                <header>
                    <button name="action_set_active" string="Set Active" type="object"
                        invisible="status not in ('draft','waiting_customer','waiting_supplier','cancelled')"
                        class="btn-primary"/>
                    <button name="action_set_waiting_customer" string="Waiting Customer" type="object"
                        invisible="status in ('done','cancelled')"/>
                    <button name="action_set_waiting_supplier" string="Waiting Supplier" type="object"
                        invisible="status in ('done','cancelled')"/>
                    <button name="action_set_done" string="Mark as Done" type="object"
                        invisible="status in ('done','cancelled')"
                        class="btn-success"/>
                    <button name="action_cancel" string="Cancel" type="object"
                        invisible="status in ('done','cancelled')"
                        class="btn-danger"/>
                    <button name="action_reset_draft" string="Reset to Draft" type="object"
                        invisible="status not in ('cancelled','done')"/>
                    <field name="status" widget="statusbar" statusbar_visible="draft,active,done"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_expenses" type="object"
                            class="oe_stat_button" icon="fa-money">
                            <field name="expense_count" widget="statinfo" string="Expenses"/>
                        </button>
                        <button name="action_view_attachments" type="object"
                            class="oe_stat_button" icon="fa-paperclip">
                            <field name="attachment_count" widget="statinfo" string="Attachments"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="project_code" readonly="1" class="text-muted" style="font-size:1rem"/>
                        </h1>
                        <h2>
                            <field name="name" placeholder="Project Name..."/>
                        </h2>
                    </div>
                    <group>
                        <group string="General">
                            <field name="customer_id"/>
                            <field name="project_type"/>
                            <field name="priority"/>
                            <field name="currency_id" groups="base.group_multi_currency"/>
                        </group>
                        <group string="Planning">
                            <field name="start_date"/>
                            <field name="deadline"/>
                            <field name="estimated_hours"/>
                            <field name="real_hours"/>
                        </group>
                    </group>
                    <group string="Financials">
                        <group>
                            <field name="hourly_rate"/>
                            <field name="expected_revenue"/>
                            <field name="real_service_value"/>
                        </group>
                        <group>
                            <field name="material_cost"/>
                            <field name="external_cost"/>
                            <field name="total_expense_cost"/>
                            <field name="estimated_profit"/>
                            <field name="real_profit"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description" name="description">
                            <field name="description" widget="html"/>
                        </page>
                        <page string="Technical Notes" name="technical_notes">
                            <field name="technical_notes" widget="html"/>
                        </page>
                        <page string="Expenses" name="expenses">
                            <field name="expense_ids" widget="one2many">
                                <list editable="bottom">
                                    <field name="date"/>
                                    <field name="name"/>
                                    <field name="expense_type"/>
                                    <field name="vendor_id"/>
                                    <field name="amount"/>
                                    <field name="currency_id" column_invisible="True"/>
                                    <field name="notes" optional="hide"/>
                                </list>
                            </field>
                        </page>
                        <page string="Results" name="results">
                            <field name="result_summary" widget="html"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- KANBAN VIEW -->
    <record id="view_rgross_engineering_project_kanban" model="ir.ui.view">
        <field name="name">rgross.engineering.project.kanban</field>
        <field name="model">rgross.engineering.project</field>
        <field name="arch" type="xml">
            <kanban default_group_by="status" class="o_kanban_small_column">
                <field name="project_code"/>
                <field name="name"/>
                <field name="customer_id"/>
                <field name="project_type"/>
                <field name="status"/>
                <field name="priority"/>
                <field name="deadline"/>
                <field name="real_profit"/>
                <field name="currency_id"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click">
                            <div class="o_kanban_record_top">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_kanban_record_title">
                                        <field name="name"/>
                                    </strong>
                                    <small class="o_kanban_record_subtitle text-muted">
                                        <field name="project_code"/>
                                    </small>
                                </div>
                                <div class="o_kanban_record_top_right">
                                    <field name="priority" widget="priority"/>
                                </div>
                            </div>
                            <div class="o_kanban_record_body">
                                <field name="customer_id"/>
                                <div t-if="record.project_type.value" class="badge text-bg-secondary mt-1">
                                    <field name="project_type"/>
                                </div>
                            </div>
                            <div class="o_kanban_record_bottom">
                                <div class="oe_kanban_bottom_left">
                                    <span t-if="record.deadline.value" class="text-muted small">
                                        <i class="fa fa-calendar"/> <field name="deadline"/>
                                    </span>
                                </div>
                                <div class="oe_kanban_bottom_right">
                                    <span class="fw-bold text-success">
                                        <field name="real_profit" widget="monetary"/>
                                    </span>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- SEARCH VIEW -->
    <record id="view_rgross_engineering_project_search" model="ir.ui.view">
        <field name="name">rgross.engineering.project.search</field>
        <field name="model">rgross.engineering.project</field>
        <field name="arch" type="xml">
            <search string="Search Projects">
                <field name="name" string="Project"/>
                <field name="project_code"/>
                <field name="customer_id"/>
                <separator/>
                <filter name="filter_active" string="Active" domain="[('status','=','active')]"/>
                <filter name="filter_waiting_customer" string="Waiting Customer" domain="[('status','=','waiting_customer')]"/>
                <filter name="filter_waiting_supplier" string="Waiting Supplier" domain="[('status','=','waiting_supplier')]"/>
                <filter name="filter_done" string="Done" domain="[('status','=','done')]"/>
                <filter name="filter_urgent" string="Urgent" domain="[('priority','=','urgent')]"/>
                <separator/>
                <filter name="filter_my_projects" string="My Open Projects"
                    domain="[('status','not in',['done','cancelled']),('create_uid','=',uid())]"/>
                <group expand="0" string="Group By">
                    <filter name="group_status" string="Status" context="{'group_by': 'status'}"/>
                    <filter name="group_type" string="Project Type" context="{'group_by': 'project_type'}"/>
                    <filter name="group_customer" string="Customer" context="{'group_by': 'customer_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- GRAPH VIEW -->
    <record id="view_rgross_engineering_project_graph" model="ir.ui.view">
        <field name="name">rgross.engineering.project.graph</field>
        <field name="model">rgross.engineering.project</field>
        <field name="arch" type="xml">
            <graph string="Projects" type="bar">
                <field name="project_type"/>
                <field name="real_profit" type="measure"/>
            </graph>
        </field>
    </record>

    <!-- PIVOT VIEW -->
    <record id="view_rgross_engineering_project_pivot" model="ir.ui.view">
        <field name="name">rgross.engineering.project.pivot</field>
        <field name="model">rgross.engineering.project</field>
        <field name="arch" type="xml">
            <pivot string="Projects">
                <field name="project_type" type="row"/>
                <field name="status" type="col"/>
                <field name="real_profit" type="measure"/>
                <field name="real_hours" type="measure"/>
                <field name="total_expense_cost" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- ACTION -->
    <record id="action_rgross_engineering_project" model="ir.actions.act_window">
        <field name="name">Engineering Projects</field>
        <field name="res_model">rgross.engineering.project</field>
        <field name="view_mode">list,kanban,form,graph,pivot</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first Engineering Project
            </p>
            <p>
                Manage your engineering projects, track time, expenses and profitability.
            </p>
        </field>
    </record>

</odoo>
